{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  labels: ["dependencies"],
  timezone: "Europe/Paris",
  schedule: ["before 9am on monday"],
  flux: {
    fileMatch: ["**/*.helmrelease.yaml"],
  },
  packageRules: [
    {
      description: "Ignorer gotk-components.yaml (auto-généré par flux bootstrap)",
      matchFileNames: ["**/gotk-components.yaml"],
      enabled: false,
    },
    {
      description: "Grouper les charts Helm infra (patch/minor)",
      matchFileNames: ["infrastructure/**/*.helmrelease.yaml"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "infrastructure Helm charts",
    },
    {
      description: "Grouper les charts Helm apps (patch/minor)",
      matchFileNames: ["apps/**/*.helmrelease.yaml"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "application Helm charts",
    },
    {
      description: "PR individuelle pour les montées majeures",
      matchUpdateTypes: ["major"],
      labels: ["dependencies", "major"],
    },
  ],
}
